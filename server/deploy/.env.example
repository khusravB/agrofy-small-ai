# Скопируйте в .env и заполните. Файл .env не коммитится.

# Домен сервера. Без своего домена подойдёт <IP-адрес>.sslip.io,
# например 203.0.113.10.sslip.io — Caddy сам получит сертификат.
AGROFY_DOMAIN=203.0.113.10.sslip.io

# vonage или twilio
AGROFY_SMS_PROVIDER=vonage

# Vonage → API Settings
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
# Купленный номер Vonage, только цифры с кодом страны, например 15551234567
VONAGE_FROM=

# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Купленный номер Twilio в формате +1…
TWILIO_FROM=

# Соль для хешей телефонов в журнале: любая длинная случайная строка,
# например вывод `openssl rand -hex 32`.
AGROFY_AUDIT_SALT=

# Ответ не длиннее N SMS-сегментов (каждый оплачивается отдельно).
# На пробных аккаунтах провайдеры добавляют к SMS приписку — тогда 2 экономнее.
AGROFY_MAX_REPLY_SEGMENTS=3

# Ссылки на веб-отчёты и файлы пакетов. По умолчанию выключены: всё приходит
# текстом, длинные ответы — несколькими SMS (интернет не нужен).
AGROFY_REPORT_LINKS=false
# Длинный ответ приходит несколькими SMS сразу (1/4, 2/4…). Не больше:
AGROFY_MAX_PAGES=8
# Сколько из них отправлять сразу; остальные — по команде ЕЩЁ или ВСЁ.
# Меньше — дешевле для фермера, больше — не нужно ничего писать.
AGROFY_PAGES_AT_ONCE=8

# Команда /ВОПРОС — любой вопрос языковой модели.
# gemini — Gemini 3.1 Flash-Lite, около $0.0008 за вопрос на платном ключе.
#   Ключ: aistudio.google.com → Get API key. На бесплатном ключе Google может
#   использовать вопросы для улучшения своих продуктов.
# openai — GPT-5.6 Luna (OPENAI_API_KEY), anthropic — Claude Haiku 5.5
#   (ANTHROPIC_API_KEY), local — своя модель (docker compose --profile llm up -d).
AGROFY_LLM_PROVIDER=gemini
GEMINI_API_KEY=
AGROFY_GEMINI_MODEL=gemini-3.1-flash-lite
AGROFY_LLM_PER_DAY=10
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
